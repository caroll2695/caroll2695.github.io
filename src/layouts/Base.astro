---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { site } from '../data/site';
import { beforeGalaxy } from '../data/career';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.name, description = site.description } = Astro.props;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  ...(site.contact.length ? [{ href: '/contact', label: 'Contact' }] : []),
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-[100dvh] flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-[var(--surface)] focus:px-4 focus:py-2">Skip to content</a>

    <header>
      <nav class="nav-pill" aria-label="Primary">
        <a href="/" class="font-medium tracking-tight">{site.name}</a>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="gutter pt-[var(--space-24)] pb-12">
      <div class="wrap">
        <p class="max-w-[48ch] text-[var(--text-muted)]" data-reveal>{beforeGalaxy}</p>
        <p class="mt-16 select-none text-[clamp(3.25rem,13.5vw,12rem)] font-medium leading-[0.9] tracking-[-0.055em] text-[var(--shell)]" aria-hidden="true" style="color: color-mix(in srgb, var(--text) 9%, transparent)">
          {site.name}
        </p>
      </div>
    </footer>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll reveals. Content is visible without JS and under reduced motion.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-in');
                io.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Count-up for key figures. Final value is in the HTML; width is reserved to avoid layout shift.
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const to = Number(el.dataset.count);
        const pre = el.dataset.prefix ?? '';
        const suf = el.dataset.suffix ?? '';
        const fmt = (n: number) => pre + Math.round(n).toLocaleString('en-US') + suf;
        el.style.display = 'inline-block';
        el.style.minWidth = `${fmt(to).length}ch`;
        if (reduce || !('IntersectionObserver' in window)) return;
        el.textContent = fmt(0);
        const io = new IntersectionObserver(([en]) => {
          if (!en.isIntersecting) return;
          io.disconnect();
          const t0 = performance.now();
          const run = (now: number) => {
            const p = Math.min((now - t0) / 1400, 1);
            el.textContent = fmt(to * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)));
            if (p < 1) requestAnimationFrame(run);
          };
          requestAnimationFrame(run);
        }, { threshold: 0.6 });
        io.observe(el);
      });
    </script>
  </body>
</html>
