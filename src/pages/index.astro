---
import Base from '../layouts/Base.astro';
import ValidatorField from '../components/ValidatorField.astro';
import Roles from '../components/Roles.astro';
import HowIWork from '../components/HowIWork.astro';
import { galaxyRoles } from '../data/career';
import { site } from '../data/site';

const stats = [
  { count: 3, prefix: '$', suffix: 'B+', label: 'peak assets under stake on the staking platform' },
  { count: 8000, prefix: '', suffix: '+', label: 'active Ethereum validators, one for each dot above' },
  { count: 30, prefix: '', suffix: '', label: 'engineers in the organization I lead' },
  { count: 500, prefix: '', suffix: 'K/s', label: 'metrics ingested across 20+ validator networks' },
];
---

<Base>
  <!-- Hero: editorial split. Full-bleed validator field on the right, type on the left. -->
  <section class="gutter relative flex min-h-[100dvh] items-center overflow-hidden pt-24 pb-16">
    <ValidatorField />
    <div class="wrap relative z-10 w-full">
      <p class="pill fade-in" style="--d: 100ms">{site.role.split(', ').slice(0, 2).join(', ')}</p>
      <h1 class="mt-8 text-[clamp(2.5rem,6.2vw,6rem)] font-medium leading-[1] tracking-[-0.05em]">
        <span class="line" style="--l: 0"><span>I build distributed systems,</span></span>
        <span class="line" style="--l: 1"><span>and the teams that run them.</span></span>
      </h1>
      <p class="fade-in mt-8 max-w-[46ch] text-lg text-[var(--text-muted)]" style="--d: 560ms">
        I lead engineering at Galaxy: the staking and tokenization products, and the forward-deployed teams who work inside our clients.
      </p>
      <div class="fade-in mt-10" style="--d: 700ms">
        <a href="/work" class="btn">See the work <span class="nub" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- Key figures: large numerals, no cards. -->
  <section aria-label="Key figures" class="gutter py-[var(--space-32)]">
    <dl class="wrap grid gap-y-14 md:grid-cols-4">
      {stats.map((s, n) => (
        <div class="md:pl-8 md:first:pl-0 md:[&:not(:first-child)]:border-l md:border-[var(--line)]" data-reveal style={`--i:${n}`}>
          <dt class="mono text-[clamp(2.5rem,5vw,4rem)] leading-none tracking-[-0.04em]">
            <span data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.count.toLocaleString('en-US')}{s.suffix}</span>
          </dt>
          <dd class="mt-4 max-w-[24ch] text-sm text-[var(--text-muted)]">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Selected work: asymmetric bento, three cells. -->
  <section class="gutter py-[var(--space-32)]">
    <div class="wrap">
      <h2 class="text-[clamp(2rem,4vw,3rem)]" data-reveal>Selected work</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-12">
        <a href="/work/staking" class="bezel md:col-span-7 md:row-span-2" data-reveal>
          <div class="core flex min-h-[26rem] flex-col justify-between p-8 md:p-10">
            <div class="pat pat-dots"></div>
            <span class="nub relative self-end" aria-hidden="true">↗</span>
            <div class="relative">
              <p class="mono text-sm text-[var(--text-faint)]">2025</p>
              <h3 class="mt-3 text-[clamp(2rem,3.4vw,2.75rem)]">Staking platform</h3>
              <p class="mt-4 max-w-[40ch] text-[var(--text-muted)]">Built and launched the platform and the business. Peak $3B+ under stake across 8,000+ Ethereum validators.</p>
            </div>
          </div>
        </a>
        <a href="/work/sweep" class="bezel md:col-span-5" data-reveal style="--i: 1">
          <div class="core flex min-h-[12.5rem] flex-col justify-between p-8">
            <div class="pat pat-rings"></div>
            <span class="nub relative self-end" aria-hidden="true">↗</span>
            <div class="relative">
              <h3 class="text-3xl">SWEEP</h3>
              <p class="mt-3 max-w-[34ch] text-[var(--text-muted)]">Galaxy's first tokenized product: an on-chain money market fund built with State Street.</p>
            </div>
          </div>
        </a>
        <a href="/work/trading-infrastructure" class="bezel md:col-span-5" data-reveal style="--i: 2">
          <div class="core flex min-h-[12.5rem] flex-col justify-between p-8">
            <div class="pat pat-lines"></div>
            <span class="nub relative self-end" aria-hidden="true">↗</span>
            <div class="relative">
              <h3 class="text-3xl">Trading infrastructure</h3>
              <p class="mt-3 max-w-[34ch] text-[var(--text-muted)]">Reliability and networking for the systems behind low-latency market making.</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- At Galaxy: sticky heading beside a scroll-drawn timeline. -->
  <section class="gutter py-[var(--space-32)]">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <h2 class="text-[clamp(2rem,4vw,3rem)]" data-reveal>At Galaxy</h2>
          <p class="mt-5 max-w-[30ch] text-[var(--text-muted)]" data-reveal style="--i: 1">Four roles since 2022: site reliability, trading infrastructure, staking, and now Edge.</p>
        </div>
      </div>
      <div class="lg:col-span-8">
        <Roles roles={galaxyRoles} />
      </div>
    </div>
  </section>

  <!-- How I work: large statements, staggered left edge. -->
  <section class="gutter py-[var(--space-32)]">
    <div class="wrap">
      <h2 class="mb-20 text-[clamp(2rem,4vw,3rem)]" data-reveal>How I work</h2>
      <HowIWork />
    </div>
  </section>
</Base>
