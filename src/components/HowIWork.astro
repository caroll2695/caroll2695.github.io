---
import { howIWork } from '../data/career';
---

<div class="space-y-24 md:space-y-32">
  {howIWork.map((h, n) => (
    <div class={n % 2 ? 'md:ml-[22%]' : ''} data-reveal>
      <p class="mono text-xs uppercase tracking-[0.18em] text-[var(--accent)]">{h.title}</p>
      <p class="mt-5 max-w-[38ch] text-[clamp(1.375rem,2.3vw,1.875rem)] font-medium leading-[1.25] tracking-[-0.025em]">{h.body}</p>
    </div>
  ))}
</div>
