---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const work = [
  { href: '/work/staking', title: 'Staking platform', period: '2025', body: 'Built and launched the platform and the business. Peak $3B+ under stake across 8,000+ Ethereum validators.', pat: 'pat-dots' },
  { href: '/work/sweep', title: 'SWEEP', period: '2026 to present', body: "Galaxy's first tokenized product: an on-chain money market fund built with State Street.", pat: 'pat-rings' },
  { href: '/work/trading-infrastructure', title: 'Trading infrastructure', period: '2022 to 2025', body: 'Infrastructure, networking and reliability for the RFS and EMS/PMS systems behind low-latency market making.', pat: 'pat-lines' },
];
---

<Base title={`Work | ${site.name}`} description="Selected work at Galaxy: staking, tokenization and trading infrastructure.">
  <section class="gutter pt-40 pb-[var(--space-32)]">
    <div class="wrap">
      <h1 class="text-[clamp(3rem,8vw,7rem)] font-medium leading-[0.98] tracking-[-0.05em]">
        <span class="line" style="--l: 0"><span>Work</span></span>
      </h1>
      <div class="mt-16 grid gap-4">
        {work.map((w, n) => (
          <a href={w.href} class="bezel" data-reveal style={`--i:${n}`}>
            <div class="core grid gap-4 p-8 md:grid-cols-[11rem_1fr_auto] md:items-center md:gap-10 md:p-10">
              <div class={`pat ${w.pat}`}></div>
              <p class="mono relative text-sm text-[var(--text-faint)]">{w.period}</p>
              <div class="relative">
                <h2 class="text-[clamp(1.75rem,3vw,2.5rem)]">{w.title}</h2>
                <p class="mt-3 max-w-[52ch] text-[var(--text-muted)]">{w.body}</p>
              </div>
              <span class="nub relative hidden md:grid" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
